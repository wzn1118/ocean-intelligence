# Use a dedicated hostname so the existing hegelsalon.com site is untouched.
SITE_HOST=ocean.hegelsalon.com
SITE_ADDRESS=ocean.hegelsalon.com
SITE_ORIGIN=https://ocean.hegelsalon.com
# Required browser-side key restricted to SITE_HOST in the Tianditu console.
VITE_TIANDITU_TOKEN=replace_with_a_tianditu_browser_key

# tunnel: Cloudflare Tunnel, no public 80/443 required. direct: Caddy on public 80/443.
DEPLOY_TRANSPORT=tunnel
# Create a dedicated Tunnel in Cloudflare Zero Trust, then paste its token here.
TUNNEL_TOKEN=replace_with_a_cloudflare_tunnel_token

# China-hosted dependency mirrors. Override with official endpoints where directly reachable.
NODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:22-alpine
PYTHON_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/python:3.13-slim
POSTGRES_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/postgres:16-alpine
CADDY_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/caddy:2-alpine
CLOUDFLARED_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/cloudflare/cloudflared:latest
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com

POSTGRES_DB=ocean_intelligence
POSTGRES_USER=ocean
# Generate a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_url_safe_random_value
# Generate with: python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=replace_with_a_fernet_key

SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000
REALTIME_CACHE_TTL_SECONDS=300
EVENT_TYPE_RECORD_TARGET=100

# Daily briefing: generate at 08:00 and publish at 09:00 Beijing time.
DAILY_BRIEF_TIME_ZONE=Asia/Shanghai
DAILY_BRIEF_GENERATE_HOUR=8
DAILY_BRIEF_PUBLISH_HOUR=9
DAILY_BRIEF_POLL_SECONDS=30
# Optional HTTP webhook for WeCom, DingTalk, Feishu or another delivery bridge.
DAILY_BRIEF_WEBHOOK_URL=

# Optional. Leave blank unless the Codex MCP endpoint is enabled.
OCEAN_CODEX_MCP_TOKEN=
OCEAN_MCP_SNAPSHOT_TTL_SECONDS=1800
OCEAN_MCP_TOOL_TIMEOUT_SECONDS=45
OCEAN_MCP_MAX_RESPONSE_BYTES=8388608
OCEAN_MCP_RATE_WINDOW_SECONDS=60
OCEAN_MCP_RATE_CALLS=120
OCEAN_MCP_TENANT_CONCURRENCY=4
OCEAN_MCP_TOOL_CONCURRENCY=8
OCEAN_MCP_JOB_WORKERS=4
OCEAN_MCP_SOURCE_SNAPSHOT_MAX_RECORDS=200000

# Optional Copernicus Marine account for wave/current products.
# Keep these values out of source control and set them only in deploy/production.env.
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=
COPERNICUSMARINE_WAVE_DATASET_ID=cmems_mod_glo_wav_anfc_0.083deg_PT3H-i
COPERNICUSMARINE_WIND_DATASET_ID=cmems_obs-wind_glo_phy_nrt_l4_0.125deg_PT1H
COPERNICUSMARINE_GLOBAL_VOLUME_CACHE_TTL_SECONDS=300
